{# Use an explicit cell alignment: Outlook can ignore margins on images. #}
{% if table_row %}<tr><td>{% endif %}
<table class="mail-image" role="presentation" border="0" cellpadding="0" cellspacing="0"
       width="100%" style="width:100%;border-collapse:collapse;mso-table-lspace:0pt;mso-table-rspace:0pt;">
  <tr>
    <td align="{{ align }}" style="text-align:{{ align }};padding:16px 0;">
      {{ content }}
    </td>
  </tr>
</table>
{% if table_row %}</td></tr>{% endif %}
