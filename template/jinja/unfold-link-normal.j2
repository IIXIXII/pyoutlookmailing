{#
  Lien texte UNFOLD. La couleur est repetee sur le lien et son contenu pour
  eviter le bleu impose par certains clients mail, y compris apres la visite.
#}
{%- if link is defined and link.url -%}
<a href="{{ link.url }}"
   class="unfold-link"
   {% if link.title is defined and link.title %}title="{{ link.title | e }}"{% endif %}
   style="color:#FFFFFF !important;
          -webkit-text-fill-color:#FFFFFF !important;
          text-decoration:underline !important;
          text-decoration-color:#FFFFFF !important;">
  <span style="color:#FFFFFF !important;
               -webkit-text-fill-color:#FFFFFF !important;
               text-decoration:underline !important;
               text-decoration-color:#FFFFFF !important;">{{ link.name }}</span>
</a>
{%- endif -%}
