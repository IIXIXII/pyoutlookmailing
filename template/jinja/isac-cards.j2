{%- import 'isac-theme.j2' as theme with context -%}
{%- set column_width = (100 / (entries | length)) | round(4) -%}
<table class="isac-cards" role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0"
       style="width:100%;border-collapse:collapse;table-layout:fixed;mso-table-lspace:0pt;mso-table-rspace:0pt;">
  <tr>
    {% for entry in entries %}
    <td class="isac-card-column" width="{{ column_width }}%" valign="top"
        style="width:{{ column_width }}%;vertical-align:top;padding:0 {{ 0 if loop.last else 8 }}px 20px 0;">
      <table role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0"
             style="width:100%;border-collapse:collapse;mso-table-lspace:0pt;mso-table-rspace:0pt;">
        <tr>
          <td bgcolor="{{ theme.panel }}" valign="top"
              style="background-color:{{ theme.panel }};border-top:3px solid {{ theme.accent }};
                     padding:14px 12px;vertical-align:top;word-wrap:break-word;">
            <h3 class="isac-card-title" style="margin:0 0 6px 0;padding:0;
                font-family:{{ theme.font }};font-size:14px;line-height:20px;
                mso-line-height-rule:exactly;font-weight:700;color:{{ theme.navy }};">{{ entry.title }}</h3>
            <p style="margin:0;padding:0;font-family:{{ theme.font }};
                      font-size:14px;line-height:22px;mso-line-height-rule:exactly;color:{{ theme.ink }};">{{ entry.text }}</p>
          </td>
        </tr>
      </table>
    </td>
    {% endfor %}
  </tr>
</table>
