{#
  Paragraphe UNFOLD sur fond sombre.

  Paramètres optionnels : mt, mb, align, textcolor, font_size et line_height.
  Un composant de bloc (par exemple unfold-button2.j2) n'est pas enveloppé
  dans un <p>, afin de conserver un HTML valide.
#}
{%- if text is defined and text -%}
  {%- set _content = text | trim -%}
  {%- set _mt = mt | default(16) | int -%}
  {%- set _mb = mb | default(16) | int -%}
  {%- set _align = align | default('justify', true) -%}
  {%- set _text_color = textcolor | default('#FFFFFF', true) -%}
  {%- set _font_size = font_size | default(18) | int -%}
  {%- set _line_height = line_height | default(28) | int -%}
  {%- if _content[0:6] | lower == '<table' -%}
    {{ _content | safe }}
  {%- else -%}
<p class="unfold-normal"
   style="margin:{{ _mt }}px 0 {{ _mb }}px 0;
          padding:0;
          color:{{ _text_color }} !important;
          -webkit-text-fill-color:{{ _text_color }} !important;
          font-family:'Circular','Aptos','Segoe UI',Arial,Helvetica,sans-serif !important;
          font-size:{{ _font_size }}px;
          font-weight:400;
          line-height:{{ _line_height }}px;
          letter-spacing:0.1px;
          text-align:{{ _align }};
          mso-line-height-rule:exactly;
          mso-margin-top-alt:{{ _mt }}px;
          mso-margin-bottom-alt:{{ _mb }}px;
          word-wrap:break-word;
          overflow-wrap:break-word;">
  {{ _content | safe }}
</p>
  {%- endif -%}
{%- endif -%}
