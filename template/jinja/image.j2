<img 
{% if inline is defined -%}
    src="data:{{ mime | default('image/png') }};base64,{{base64}}"
	{% else -%}
	{% if cid is defined -%}
		src="cid:{{src}}"
		{% else -%}
		src="{{src}}"	
	{%- endif %}
{%- endif %}
 alt="{{alt}}" 
{% if title is defined -%}
    title="{{title}}"
{%- endif %}
{% if width is defined -%}
    width="{{ width }}"
{%- endif %}
    style="{% if width is defined %}width:{{ width }};max-width:100%;height:auto;{% endif %}{% if align == 'right' %}float:right;{% elif align == 'left' %}float:left;{% else %}margin:0 auto;display:block;{% endif %}"
/>
